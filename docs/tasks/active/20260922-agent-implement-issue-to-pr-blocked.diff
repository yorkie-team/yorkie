+    // EVERY refusal must be a sentence, not a thrown name. This is the `also`
+    // regression, asserted for all of them rather than for the one that had it.
+    for (const f of failures) assert.match(f, /refusing to run\.|Refusing to run\./, `unhelpful refusal: ${f}`);
+    return { failures, warnings, asked };
+  };
+
+  const reviews = (extra) => ({
+    required_pull_request_reviews: { required_approving_review_count: 1, require_last_push_approval: true, ...extra },
+  });
+  const ruleset = (extra) => ({
+    name: "protect main", enforcement: "active", current_user_can_bypass: "never", bypass_actors: [], ...extra,
+  });
+  const prRule = (extra) => ({
+    type: "pull_request", ruleset_id: 7,
+    parameters: { required_approving_review_count: 1, require_last_push_approval: true, ...extra },
+  });
+
+  // 1) The passing shape: classic protection, one approval, nobody may bypass,
+  //    and the approval does not survive the agent's next push.
+  assert.deepEqual((await run({ classic: reviews() })).failures, [], "clean classic protection must be accepted");
+
+  // 2) A bypass allowance is not protection — and this is the ONE reason whose
+  //    message deliberately omits the Administration:read tail, because the
+  //    repository answered clearly and the fix is to drop the allowance.
+  {
+    const { failures } = await run({
+      classic: reviews({ bypass_pull_request_allowances: { users: [], teams: [], apps: [{ slug: "agent" }] } }),
+      rules: [],
+    });
+    assert.equal(failures.length, 1);
+    assert.match(failures[0], /1 actor\(s\) may bypass it/);
+    assert.equal(/Administration: read/.test(failures[0]), false, "the bypass reason must not send them to the App");
+  }
+
+  // 3) An approval that survives the next push is the agent approving its own
+  //    later commits by omission. Refused, and named as itself.
+  {
+    const { failures } = await run({ classic: reviews({ require_last_push_approval: false }), rules: [] });
+    assert.equal(failures.length, 1);
+    assert.match(failures[0], /most recent reviewable push/);
+  }
+
+  // 4) A question we could not ask is not an answer: a 403 is fatal and must
+  //    NOT fall through to the ruleset probe.
+  {
+    const { failures, asked } = await run({ classicError: err("Forbidden", 403) });
+    assert.equal(failures.length, 1);
+    assert.match(failures[0], /HTTP 403/);
+    assert.match(failures[0], /Administration: read/);
+    assert.deepEqual(asked, ["classic"], "a fatal classic error must stop before the rulesets");
+  }
+
+  // 5) 404 means "no classic protection", and a clean ruleset then carries it.
+  assert.deepEqual(
+    (await run({ classicError: NOT_FOUND, rules: [prRule()], rulesets: { 7: ruleset() } })).failures,
+    [],
+    "a visible, empty, never-bypassable, active ruleset must be accepted",
+  );
+
+  // 6) …and every way a ruleset stops carrying it. Each is a DIFFERENT repository
+  //    state with the same safe answer; all four used to be untested.
+  for (const [why, rs] of [
+    ["a named bypass actor", ruleset({ bypass_actors: [{ actor_id: 1 }] })],
+    ["a bypass list this token cannot see", ruleset({ bypass_actors: undefined })],
+    ["this token may bypass", ruleset({ current_user_can_bypass: "always" })],
+    ["the ruleset is only evaluating", ruleset({ enforcement: "evaluate" })],
+  ]) {
+    const { failures, warnings } = await run({
+      classicError: NOT_FOUND, rules: [prRule()], rulesets: { 7: rs },
+    });
+    assert.equal(failures.length, 1, `${why}: must refuse`);
+    assert.match(failures[0], /not protected by a required human review/, why);
+    assert.equal(warnings.length, 1, `${why}: must say which ruleset it discounted`);
+  }
+
+  // 7) A ruleset this token cannot READ is counted per ruleset, and reported as
+  //    "may be protected by something I cannot read" — not as "unprotected".
+  {
+    const { failures } = await run({
+      classicError: NOT_FOUND, rules: [prRule()], rulesetErrors: { 7: err("Not Found", 404) },
+    });
+    assert.equal(failures.length, 1);
+    assert.match(failures[0], /1 ruleset\(s\) this token cannot read/);
+    assert.match(failures[0], /Administration: read/);
+  }
+
+  // 8) Failing to LIST is a third state again, and must not claim a count it
+  //    never enumerated.
+  {
+    const { failures } = await run({ classicError: NOT_FOUND, rulesError: err("boom", 500) });
+    assert.equal(failures.length, 1);
+    assert.match(failures[0], /could not be listed at all/);
+    assert.equal(/ruleset\(s\) this token cannot read/.test(failures[0]), false);
+  }
+
+  // 9) A pull_request rule without require_last_push_approval is the ruleset-side
+  //    of case 3, and must be named as that rather than as "unprotected".
+  {
+    const { failures } = await run({
+      classicError: NOT_FOUND, rules: [prRule({ require_last_push_approval: false })], rulesets: { 7: ruleset() },
+    });
+    assert.equal(failures.length, 1);
+    assert.match(failures[0], /most recent reviewable push/);
+  }
+
+  // 10) Nothing at all.
+  {
+    const { failures } = await run({ classicError: NOT_FOUND, rules: [] });
+    assert.equal(failures.length, 1);
+    assert.match(failures[0], /neither classic protection nor a ruleset provides one/);
+  }
+});
+
+test("the implement agent's own token cannot approve or merge a pull request", () => {
+  // THE GATE THIS VERB IS JUSTIFIED ON IS "main requires a human approving
+  // review". `pull-requests: write` is the scope that SUBMITS an approving
+  // review (`POST /pulls/{n}/reviews`) and, beside `contents: write`, the scope
+  // that MERGES (`PUT /pulls/{n}/merge`). GitHub only blocks approving a PR the
+  // same identity authored — so one App token carrying both, handed to an agent
+  // running with unrestricted `Bash` on text an arbitrary GitHub user wrote,
+  // made the gate satisfiable by the party it exists to constrain.
+  //
+  // Two tokens fix it, and this test is the thing that keeps them two: the agent
+  // gets `contents` + `issues`, and everything needing `pull-requests` happens in
+  // a step of this workflow. Re-merging them is a one-line change that no other
+  // assertion here would notice.
+  const wf = WF("agent-implement.yml");
+  const lines = wf.split("\n");
+  const stepAround = (i) => {
+    let start = i;
+    while (start > 0 && !/^ {6}- /.test(lines[start])) start--;
+    let end = start + 1;
+    while (end < lines.length && !/^ {6}- /.test(lines[end]) && !/^ {2}\S/.test(lines[end])) end++;
+    return lines.slice(start, end).join("\n");
+  };
+  const find = (needle, from = 0) => {
+    const i = lines.findIndex((l, k) => k >= from && l.includes(needle));
+    assert.ok(i > 0, `agent-implement.yml no longer has \`${needle}\``);
+    return i;
+  };
+  // `id: agent` is a PREFIX of `id: agent-token`, and a substring search for it
+  // finds the mint rather than the agent step — which would make the ordering
+  // assertion below pass on a workflow that had moved the agent step anywhere.
+  const findId = (id) => {
+    const i = lines.findIndex((l) => l.trim() === `id: ${id}`);
+    assert.ok(i > 0, `agent-implement.yml no longer has a step with \`id: ${id}\``);
+    return i;
+  };
+
+  const mintAt = findId("agent-token");
+  const perms = [...stepAround(mintAt).matchAll(/^\s*permission-([a-z-]+):/gm)].map((m) => m[1]).sort();
+  assert.deepEqual(
+    perms,
+    ["contents", "issues"],
+    "the agent's token must carry exactly contents+issues — `pull-requests` is approve and merge, and " +
+      "`administration` is the gate's own read",
+  );
+
+  // The action's `github_token` is what `gh` inside the agent authenticates
+  // with, so this line is the whole separation.
+  const agentStep = stepAround(find("uses: anthropics/claude-code-action@"));
+  assert.match(
+    agentStep,
+    /github_token: \$\{\{ steps\.agent-token\.outputs\.token \}\}/,
+    "the agent must be given the narrow token",
+  );
+  assert.equal(
+    /steps\.app-token\.outputs\.token/.test(agentStep),
+    false,
+    "the trusted token must not reach the agent step",
+  );
+
+  // …and the checkout, because `persist-credentials` writes whichever token it
+  // is given into `.git/config`, which the agent reads with one `Bash` call.
+  assert.match(
+    stepAround(find("uses: actions/checkout@", mintAt)),
+    /token: \$\{\{ steps\.agent-token\.outputs\.token \}\}/,
+    "the workspace checkout must persist the narrow token, or the agent holds the trusted one anyway",
+  );
+
+  // Which means the PR cannot be opened by the agent, and is not.
+  const promptEnd = wf.indexOf("\n          PROMPT\n");
+  assert.ok(promptEnd > 0, "the prompt heredoc is gone");
+  assert.match(
+    wf.slice(0, promptEnd),
+    /Do NOT run `gh pr create`/,
+    "the prompt must tell the agent the verb it no longer has, or it burns turns on a 403",
+  );
+  const opens = [...wf.matchAll(/gh pr create[^\n]*/g)].filter((m) => m.index > promptEnd);
+  assert.equal(opens.length, 1, `exactly one step may open the pull request, found ${opens.length}`);
+  assert.match(
+    opens[0][0],
+    /--draft/,
+    "the trusted step must pass --draft unconditionally — that is what stops `draft` being a prompt convention",
+  );
+  // AND IT MUST RUN AFTER THE AGENT. agent-review-panel.yml and
+  // agent-iterate-ci.yml both claim any `agent/`-prefixed head branch and
+  // dispatch fixers that PUSH to it; both are reached only through a CI run, and
+  // CI runs on `pull_request`. Opening the PR while the agent is still
+  // committing is what gives that branch three writers.
+  assert.ok(
+    findId("pr") > findId("agent"),
+    "the PR must open after the agent step, or the panel and iterate-ci push to the branch mid-run",
+  );
+});
