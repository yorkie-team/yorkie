+    .map((l) => (l.startsWith(" ".repeat(12)) ? l.slice(12) : l))
+    .join("\n");
+  const gate = new Function("github", "core", "context", `return (async () => {\n${src}\n})();`);
+
+  const err = (message, status) => Object.assign(new Error(message), status ? { status } : {});
+  const NOT_FOUND = err("Branch not protected", 404);
+  const run = async ({ classic, classicError, rules, rulesError, rulesets = {}, rulesetErrors = {} }) => {
+    const failures = [], warnings = [];
+    const asked = [];
+    const github = {
+      rest: {
+        repos: {
+          getBranchProtection: async () => {
+            asked.push("classic");
+            if (classicError) throw classicError;
+            return { data: classic };
+          },
+        },
+      },
+      request: async (route, params) => {
+        if (route.includes("/rules/branches/")) {
+          asked.push("rules");
+          if (rulesError) throw rulesError;
+          return { data: rules ?? [] };
+        }
+        asked.push(`ruleset:${params.id}`);
+        if (rulesetErrors[params.id]) throw rulesetErrors[params.id];
+        return { data: rulesets[params.id] };
+      },
+    };
+    const core = {
+      setFailed: (m) => failures.push(String(m)),
+      warning: (m) => warnings.push(String(m)),
+      info: () => {},
+    };
+    await gate(github, core, { repo: { owner: "yorkie-team", repo: "yorkie" } });
+    // EVERY refusal must be a sentence, not a thrown name. This is the `also`
+    // regression, asserted for all of them rather than for the one that had it.
+    for (const f of failures) assert.match(f, /refusing to run\.|Refusing to run\./, `unhelpful refusal: ${f}`);
+    return { failures, warnings, asked };
+  };
+
+  const reviews = (extra) => ({
+    required_pull_request_reviews: { required_approving_review_count: 1, require_last_push_approval: true, ...extra },
+  });
+  const ruleset = (extra) => ({
+    name: "protect main", enforcement: "active", current_user_can_bypass: "never", bypass_actors: [], ...extra,
+  });
+  const prRule = (extra) => ({
+    type: "pull_request", ruleset_id: 7,
+    parameters: { required_approving_review_count: 1, require_last_push_approval: true, ...extra },
+  });
+
+  // 1) The passing shape: classic protection, one approval, nobody may bypass,
+  //    and the approval does not survive the agent's next push.
+  assert.deepEqual((await run({ classic: reviews() })).failures, [], "clean classic protection must be accepted");
+
+  // 2) A bypass allowance is not protection — and this is the ONE reason whose
+  //    message deliberately omits the Administration:read tail, because the
+  //    repository answered clearly and the fix is to drop the allowance.
+  {
+    const { failures } = await run({
+      classic: reviews({ bypass_pull_request_allowances: { users: [], teams: [], apps: [{ slug: "agent" }] } }),
+      rules: [],
+    });
+    assert.equal(failures.length, 1);
+    assert.match(failures[0], /1 actor\(s\) may bypass it/);
+    assert.equal(/Administration: read/.test(failures[0]), false, "the bypass reason must not send them to the App");
+  }
+
+  // 3) An approval that survives the next push is the agent approving its own
+  //    later commits by omission. Refused, and named as itself.
+  {
+    const { failures } = await run({ classic: reviews({ require_last_push_approval: false }), rules: [] });
+    assert.equal(failures.length, 1);
+    assert.match(failures[0], /most recent reviewable push/);
+  }
+
+  // 4) A question we could not ask is not an answer: a 403 is fatal and must
+  //    NOT fall through to the ruleset probe.
+  {
+    const { failures, asked } = await run({ classicError: err("Forbidden", 403) });
+    assert.equal(failures.length, 1);
+    assert.match(failures[0], /HTTP 403/);
+    assert.match(failures[0], /Administration: read/);
+    assert.deepEqual(asked, ["classic"], "a fatal classic error must stop before the rulesets");
+  }
+
+  // 5) 404 means "no classic protection", and a clean ruleset then carries it.
+  assert.deepEqual(
+    (await run({ classicError: NOT_FOUND, rules: [prRule()], rulesets: { 7: ruleset() } })).failures,
+    [],
+    "a visible, empty, never-bypassable, active ruleset must be accepted",
+  );
+
+  // 6) …and every way a ruleset stops carrying it. Each is a DIFFERENT repository
+  //    state with the same safe answer; all four used to be untested.
+  for (const [why, rs] of [
+    ["a named bypass actor", ruleset({ bypass_actors: [{ actor_id: 1 }] })],
+    ["a bypass list this token cannot see", ruleset({ bypass_actors: undefined })],
+    ["this token may bypass", ruleset({ current_user_can_bypass: "always" })],
+    ["the ruleset is only evaluating", ruleset({ enforcement: "evaluate" })],
+  ]) {
+    const { failures, warnings } = await run({
+      classicError: NOT_FOUND, rules: [prRule()], rulesets: { 7: rs },
+    });
+    assert.equal(failures.length, 1, `${why}: must refuse`);
+    assert.match(failures[0], /not protected by a required human review/, why);
+    assert.equal(warnings.length, 1, `${why}: must say which ruleset it discounted`);
+  }
+
+  // 7) A ruleset this token cannot READ is counted per ruleset, and reported as
+  //    "may be protected by something I cannot read" — not as "unprotected".
+  {
+    const { failures } = await run({
+      classicError: NOT_FOUND, rules: [prRule()], rulesetErrors: { 7: err("Not Found", 404) },
+    });
+    assert.equal(failures.length, 1);
+    assert.match(failures[0], /1 ruleset\(s\) this token cannot read/);
+    assert.match(failures[0], /Administration: read/);
+  }
+
+  // 8) Failing to LIST is a third state again, and must not claim a count it
+  //    never enumerated.
+  {
+    const { failures } = await run({ classicError: NOT_FOUND, rulesError: err("boom", 500) });
+    assert.equal(failures.length, 1);
+    assert.match(failures[0], /could not be listed at all/);
+    assert.equal(/ruleset\(s\) this token cannot read/.test(failures[0]), false);
+  }
+
+  // 9) A pull_request rule without require_last_push_approval is the ruleset-side
+  //    of case 3, and must be named as that rather than as "unprotected".
+  {
+    const { failures } = await run({
+      classicError: NOT_FOUND, rules: [prRule({ require_last_push_approval: false })], rulesets: { 7: ruleset() },
+    });
+    assert.equal(failures.length, 1);
+    assert.match(failures[0], /most recent reviewable push/);
+  }
+
+  // 10) Nothing at all.
+  {
+    const { failures } = await run({ classicError: NOT_FOUND, rules: [] });
+    assert.equal(failures.length, 1);
+    assert.match(failures[0], /neither classic protection nor a ruleset provides one/);
+  }
+});
